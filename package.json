{
  "name": "practica-1-amc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run docs:figures && npm run api:build && npm run docs:build",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "predocs:dev": "npm run docs:figures && npm run api:build",
    "docs:dev": "vitepress dev docs",
    "docs:figures": "node scripts/generate-doc-figures.mjs",
    "docs:build": "vitepress build docs",
    "api:build": "typedoc",
    "site:build": "npm run docs:figures && npm run api:build && npm run docs:build && npm run build"
  },
  "private": true,
  "homepage": "https://practica-1-amc.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoidaan/practica-1-amc.git"
  },
  "bugs": {
    "url": "https://github.com/acoidaan/practica-1-amc/issues"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "vitepress": {
      "vite": "6.4.4"
    }
  }
}
